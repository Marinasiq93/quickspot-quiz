# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - highly sensitive, server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel access
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# Default per-question countdown, in seconds, when a question has no override.
DEFAULT_TIME_LIMIT_SECONDS=20
